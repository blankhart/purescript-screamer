-- Generated by psx from Psx.psx
-- | The table scenario on Screamer, in PSX. The rows are Screamer's own
-- | `each`, keyed by id; each row reads its id once and binds its label and
-- | class to signals.
module App.Table.Screamer.Psx (main) where
import Prelude

import Data.Array as Array
import Data.Maybe (Maybe(..))
import Effect (Effect)
import Effect.Class (liftEffect)
import Effect.Ref as Ref
import Screamer.Signal (Signal, readT0)
import Screamer.Source (signalSource)
import Suite.Shared.Dom (removeApp)
import Suite.Shared.Table (TableRow)
import Suite.Shared.Table as Table
import Screamer.Element (Element, component, each, mount)
import Screamer.Psx (Markup, root)
import Screamer.Psx as B
-- | What the view shows and what its handlers do.
type Props =
  { rows :: Signal (Array TableRow)
  , selected :: Signal (Maybe Int)
  , buttons :: Array { id :: String, text :: String, action :: Effect Unit }
  , select :: Int -> Effect Unit
  , remove :: Int -> Effect Unit
  }

table :: Number -> Element
table seed = component do
  rows <- liftEffect $ signalSource []
  selected <- liftEffect $ signalSource Nothing
  source <- liftEffect $ Ref.new (Table.source seed)
  let
    make n = do
      made <- Table.rows n <$> Ref.read source
      Ref.write made.source source
      pure made.rows
    buttons =
      [ { id: "run", text: "Create 1,000 rows", action: make 1000 >>= rows.putT1 }
      , { id: "runlots", text: "Create 10,000 rows", action: make 10000 >>= rows.putT1 }
      , { id: "add", text: "Append 1,000 rows", action: make 1000 >>= \made -> rows.modifyT1 (_ <> made) }
      , { id: "update", text: "Update every 10th row", action: rows.modifyT1 Table.updateEvery }
      , { id: "clear", text: "Clear", action: rows.putT1 [] }
      , { id: "swaprows", text: "Swap Rows", action: rows.modifyT1 Table.swap }
      ]
    remove id = rows.modifyT1 (Array.filter \r -> r.id /= id)
  pure $ root $ view { rows: rows.signal, selected: selected.signal, buttons, select: selected.putT1 <<< Just, remove }

view :: Props -> Markup (Effect Unit)
view props =
  [ B.div [ B.class_ "container", B.attribute "data-testid" "table" ] ([
    B.div [ B.class_ "jumbotron" ] ([
      B.div [ B.class_ "row" ] ([
        B.div [ B.class_ "col-md-6" ] ([ B.h1 [] ([ B.text "PSX table" ]) ]),
        B.div [ B.class_ "col-md-6" ] (B.children (

            map
              ( \b ->
                  [ B.div [ B.class_ "col-sm-6 smallpad" ] ([
                    B.button [ B.type' "button", B.class_ "btn btn-primary btn-block", B.id (b.id), B.attribute "data-testid" (b.id), B.onClick (b.action) ] (B.children (b.text)) ]
                   ) ]
              )
              props.buttons)

   ) ]
   ) ]
   ),
    B.table [ B.class_ "table table-hover table-striped test-data" ] ([
      B.tbody [] (B.children (
         each _.id props.rows (row props))
   ) ]
   ),
    B.span [ B.class_ "preloadicon glyphicon glyphicon-remove", B.ariaHidden "true" ] B.none ]
   ) ]

row :: Props -> Signal TableRow -> Element
row props r = component do
  { id } <- liftEffect (readT0 r)
  pure $ root
    ( [ B.tr [ B.class_ ((\s -> if s == Just id then "danger" else "row") <$> props.selected) ] ([
        B.td [ B.class_ "col-md-1" ] (B.children (show id)),
        B.td [ B.class_ "col-md-4" ] ([ B.a [ B.attribute "data-testid" ("select-" <> show id), B.onClick (props.select id) ] (B.children (_.label <$> r)) ]),
        B.td [ B.class_ "col-md-1" ] ([
          B.a [ B.attribute "data-testid" ("remove-" <> show id), B.onClick (props.remove id) ] ([ B.span [ B.class_ "glyphicon glyphicon-remove", B.ariaHidden "true" ] B.none ]) ]
     ),
        B.td [ B.class_ "col-md-6" ] B.none ]
     ) ]
    )

-- | Mounts in place of `#app`, with the scenario's seed.
main :: { seed :: Number } -> Effect Unit
main fixture = do
  removeApp
  void $ mount "#root" (table fixture.seed)
