-- Generated by psx from HelloWorld.psxt
-- | A counter: the smallest Screamer component. Screamer's own HelloWorld
-- | example, with its view in PSX.
module Screamer.Psx.Examples.HelloWorld where

import Prelude

import Effect (Effect)
import Effect.Class (liftEffect)
import Screamer.Psx.Examples.Harness as Harness
import Screamer.Element (Element, component)
import Screamer.Psx (Markup, root)
import Screamer.Psx as B
import Screamer.Source (SignalSource, signalSource)
main :: Effect Unit
main = Harness.run "main" counter

counter :: Element
counter = component do
  count <- liftEffect $ signalSource 0
  pure $ root (view count)



view :: SignalSource Int -> Markup (Effect Unit)
view count =
  [ B.div [ B.class_ "counter" ] ([
    B.button [ B.id "decrement", B.onClick (count.modifyT1 (_ - 1)) ] ([ B.text "-" ]),
    B.span [ B.id "count" ] (B.children (show <$> count.signal)),
    B.button [ B.id "increment", B.onClick (count.modifyT1 (_ + 1)) ] ([ B.text "+" ]) ]
 ) ]

