-- Generated by psx from Psx.psx
-- | The todo scenario on Screamer, in PSX. The list is Screamer's own
-- | `each`, keyed by id, in a hole; each row reads its id once and binds
-- | the rest to the row's signal.
module App.Todo.Screamer.Psx (main) where
import Prelude

import Data.Array as Array
import Data.Foldable (foldl)
import Effect (Effect)
import Effect.Class (liftEffect)
import Effect.Ref as Ref
import Screamer.Element (Element, component, each, mount)
import Screamer.Psx (Markup, root)
import Screamer.Psx as B
import Screamer.Signal (Signal, readT0)
import Screamer.Source (batch, signalSource)
import Suite.Shared.Dom (removeApp)
type Todo = { id :: Int, text :: String, done :: Boolean }

type Fixture = { todos :: Array Todo }

data Filter = All | Active | Completed

derive instance Eq Filter

shown :: Filter -> Todo -> Boolean
shown filter todo = case filter of
  All -> true
  Active -> not todo.done
  Completed -> todo.done

-- | What the view shows and what its handlers do.
type Props =
  { todos :: Signal (Array Todo)
  , draft :: Signal String
  , filter :: Signal Filter
  , setDraft :: String -> Effect Unit
  , add :: Effect Unit
  , toggle :: Int -> Effect Unit
  , remove :: Int -> Effect Unit
  , show :: Filter -> Effect Unit
  }

todoApp :: Fixture -> Element
todoApp fixture = component do
  todos <- liftEffect $ signalSource fixture.todos
  draft <- liftEffect $ signalSource ""
  filter <- liftEffect $ signalSource All
  next <- liftEffect $ Ref.new (1 + foldl (\n todo -> max n todo.id) 0 fixture.todos)
  let
    add = do
      id <- Ref.modify (_ + 1) next
      text <- readT0 draft.signal
      batch do
        todos.modifyT1 (_ <> [ { id: id - 1, text, done: false } ])
        draft.putT1 ""
    toggle id = todos.modifyT1 $ map \todo -> if todo.id == id then todo { done = not todo.done } else todo
    remove id = todos.modifyT1 $ Array.filter \todo -> todo.id /= id
  pure $ root $ view
    { todos: todos.signal
    , draft: draft.signal
    , filter: filter.signal
    , setDraft: draft.putT1
    , add
    , toggle
    , remove
    , show: filter.putT1
    }

view :: Props -> Markup (Effect Unit)
view props =
  [ B.section [ B.class_ "todo", B.attribute "data-testid" "todo" ] ([
    B.h1 [] ([ B.text "Todos" ]),
    B.div [ B.class_ "new" ] ([
      B.input [ B.type' "text", B.attribute "data-testid" "draft", B.value (props.draft), B.onInput (props.setDraft) ] B.none,
      B.button [ B.attribute "data-testid" "add", B.onClick (props.add), B.disabled ((_ == "") <$> props.draft) ] ([ B.text "Add" ]) ]
   ),
    B.ul [ B.class_ "items" ] (B.children (
       each _.id (Array.filter <$> (shown <$> props.filter) <*> props.todos) (item props))
   ),
    B.p [ B.attribute "data-testid" "left" ] (B.children (show <<< Array.length <<< Array.filter (not <<< _.done) <$> props.todos) <> [ B.text " left" ]),
    B.div [ B.class_ "filters" ] ([
      B.button [ B.attribute "data-testid" "all", B.onClick (props.show All), B.disabled ((_ == All) <$> props.filter) ] ([ B.text "All" ]),
      B.button [ B.attribute "data-testid" "active", B.onClick (props.show Active), B.disabled ((_ == Active) <$> props.filter) ] ([ B.text "Active" ]),
      B.button [ B.attribute "data-testid" "completed", B.onClick (props.show Completed), B.disabled ((_ == Completed) <$> props.filter) ] ([ B.text "Completed" ]) ]
   ) ]
   ) ]

item :: Props -> Signal Todo -> Element
item props todo = component do
  { id } <- liftEffect (readT0 todo)
  pure $ root
    ( [ B.li [ B.class_ ((\t -> if t.done then "item done" else "item") <$> todo) ] ([
        B.input [ B.type' "checkbox", B.attribute "data-testid" ("toggle-" <> show id), B.checked (_.done <$> todo), B.onChange (props.toggle id) ] B.none,
        B.span [] (B.children (_.text <$> todo)),
        B.button [ B.attribute "data-testid" ("remove-" <> show id), B.onClick (props.remove id) ] ([ B.text "Remove" ]) ]
     ) ]
    )

-- | Mounts in place of `#app`, starting from the scenario's fixture.
main :: Fixture -> Effect Unit
main fixture = do
  removeApp
  void $ mount "#root" (todoApp fixture)
