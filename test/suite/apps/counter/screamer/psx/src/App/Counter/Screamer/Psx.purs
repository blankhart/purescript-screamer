-- Generated by psx from Psx.psx
-- | The counter scenario on Screamer, in PSX: `App.Counter` from the design
-- | doc, with its scoped `<style>`. Screamer builds the view once, so what
-- | changes is a signal in a hole or an attribute.
module App.Counter.Screamer.Psx (main) where
import Prelude
import Data.Array ((..))
import Effect (Effect)
import Effect.Class (liftEffect)
import Screamer.Element (component, mount)
import Screamer.Psx (Markup, root)
import Screamer.Psx as B
import App.Counter.Screamer.Psx.PsxStyle as B.Style
import Screamer.Signal (Signal)
import Screamer.Source (signalSource)
import Suite.Shared.Dom (removeApp)
type Props = { label :: String, max :: Int }

data Msg = Increment | Decrement | Reset

update :: Int -> Msg -> Int
update n = case _ of
  Increment -> n + 1
  Decrement -> n - 1
  Reset -> 0

view :: Props -> Signal Int -> (Msg -> Effect Unit) -> Markup (Effect Unit)
view props n send =
  [ B.section [ B.class_ "counter", B.attribute "data-testid" "counter", B.attribute "data-psx" B.Style.scope ] ([
    B.h2 [ B.attribute "data-testid" "label" ] (B.children (props.label) <> [ B.text ": " ] <> B.children (show <$> n)),
    B.button [ B.attribute "data-testid" "decrement", B.onClick (send Decrement), B.disabled ((_ <= 0) <$> n) ] ([ B.text "-" ]),
    B.button [ B.attribute "data-testid" "increment", B.onClick (send Increment), B.disabled ((_ >= props.max) <$> n) ] ([ B.text "+" ]) ] <> B.children (

      n <#> \count ->
        if count == 0 then
          []
        else
          [ B.button [ B.attribute "data-testid" "reset", B.onClick (send Reset) ] ([ B.text "Reset" ]) ]) <> [

    B.ol [ B.class_ "pips" ] (B.children (

        map
          (\i -> [ B.keyed (i) (B.li [ B.class_ ((\count -> if i <= count then "pip filled" else "pip") <$> n) ] B.none) ])
          (1 .. props.max))

   ) ]





   ) ]

-- | Mounts in place of `#app`, with the scenario's fixture as the props.
main :: Props -> Effect Unit
main props = do
  removeApp
  void $ mount "#root" $ component do
    n <- liftEffect (signalSource 0)
    pure $ root (view props n.signal \msg -> n.modifyT1 (\count -> update count msg))
