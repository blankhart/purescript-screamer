-- | Event types
module Screamer.DOM.Event where

import Prelude

import Effect (Effect)
import Data.Maybe (Maybe)
import Data.Nullable as Nullable
import Screamer.Internal (property, eventEffect, eventCast)
import Web.Event.EventTarget (EventTarget)

{{#each EventClasses}}

foreign import data {{event_class}} :: Type

class Is{{event_class}} a

{{#each event_fields}}
{{field}}_ :: forall a. Is{{../event_class}} a => a -> {{capitalize value}}
{{field}}_ = property "{{field}}"

{{/each}}
{{#each event_effects}}
{{field}}_ :: forall a. Is{{../event_class}} a => a -> Effect Unit
{{field}}_ = eventEffect "{{field}}"

{{/each}}
instance is{{event_class}}{{event_class}} :: Is{{event_class}} {{event_class}}

{{#each event_superclasses}}
instance is{{this}}{{../event_class}} :: Is{{this}} {{../event_class}}

{{/each}}
to{{event_class}} :: forall a. a -> Maybe {{event_class}}
to{{event_class}} = Nullable.toMaybe <<< eventCast "{{event_class}}"

{{/each}}

-- TODO: Integrations with Web.*** library types
-- EventTarget should have a phantom type parameter preserving evidence about
-- the event that generated it so that it can safely be unwrapped in some cases.
-- For example, returning the value of the node on an InputEvent.

target :: forall a . IsEvent a => a -> EventTarget
target = property "target"

inputValue :: forall a. IsInput a => a -> String
inputValue = property "target" >>> property "value"
