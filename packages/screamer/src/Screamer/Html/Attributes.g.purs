prop_ name v = property name (toSignal v)

-- | Inline styles from a record of CSS properties, each a `String` or a
-- | `Signal String`. Labels are checked against `CssProperties`.
style_ :: forall r. StyleRecord r => Record r -> Attribute
style_ = attributes <<< styleAttributes

class StyleRecord (r :: Row Type) where
  styleAttributes :: Record r -> Array Attribute

instance (RowToList r rl, StyleFields rl r) => StyleRecord r where
  styleAttributes = styleFields (Proxy :: Proxy rl)

class StyleFields (rl :: RowList Type) (r :: Row Type) where
  styleFields :: Proxy rl -> Record r -> Array Attribute

instance StyleFields Nil r where
  styleFields _ _ = []

instance
  ( IsSymbol name
  , Row.Cons name Unit known CssProperties
  , Row.Cons name v rest r
  , AttrValue v String
  , StyleFields tail r
  ) =>
  StyleFields (Cons name v tail) r where
  styleFields _ rec =
    [ styleProperty (reflectSymbol name) (toSignal (Record.get name rec)) ]
      <> styleFields (Proxy :: Proxy tail) rec
    where
    name = Proxy :: Proxy name

