{
  "private": true,
  "name": "purescript-screamer",
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "bench": "tsc && spago bundle -p screamer-examples --module Screamer.Examples.JsFrameworksBenchmark --outfile output/JsFrameworksBenchmark.js",
    "build": "tsc && spago build",
    "build:examples": "tsc && node examples/build.mjs",
    "codegen:dom": "tsx codegen/dom.ts",
    "format": "purs-tidy format-in-place \"src/**/*.purs\" \"examples/**/*.purs\"",
    "hello": "tsc && spago bundle -p screamer-examples --module Screamer.Examples.HelloWorld --outfile output/HelloWorld.js",
    "rainbow": "tsc && spago bundle -p screamer-examples --module Screamer.Examples.RainbowSpiral --outfile output/RainbowSpiral.js",
    "postinstall": "spago install",
    "serve": "parcel examples/output/HelloWorld.html",
    "serve:rainbow": "parcel examples/output/RainbowSpiral.html",
    "serve:bench": "parcel examples/output/JsFrameworksBenchmark.html",
    "bench:measure": "npm run bench && node bench/measure.mjs",
    "test": "npm run test:core && npm run test:purs && npm run test:compile-fail",
    "test:core": "node --import tsx --expose-gc --test \"test/core/**/*.test.ts\"",
    "test:purs": "tsc && NODE_OPTIONS=\"--import ./test/setup-dom.mjs\" spago test",
    "test:compile-fail": "node compile-fail/run.mjs"
  },
  "dependencies": {
    "sinuous": "0.32.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "handlebars": "^4.7.10",
    "jsdom": "^26.1.0",
    "parcel": "^2.16.4",
    "playwright": "^1.56.1",
    "purescript": "^0.15.16",
    "purs-tidy": "^0.11.1",
    "spago": "^1.0.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
