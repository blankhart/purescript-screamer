{
  "private": true,
  "name": "purescript-screamer",
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "bench": "tsc && spago bundle -p screamer-examples --module Screamer.Examples.JsFrameworksBenchmark --outfile output/JsFrameworksBenchmark.bench.js --bundler-args --define:__DEV__=false",
    "build": "tsc && spago build",
    "build:examples": "tsc && node examples/build.mjs",
    "codegen:dom": "tsx codegen/dom.ts",
    "format": "purs-tidy format-in-place \"packages/*/src/**/*.purs\" \"packages/*/test/**/*.purs\" \"examples/**/*.purs\"",
    "hello": "tsc && node examples/build.mjs HelloWorld",
    "rainbow": "tsc && node examples/build.mjs RainbowSpiral",
    "postinstall": "spago install",
    "serve": "node examples/serve.mjs examples/output",
    "serve:rainbow": "node examples/serve.mjs examples/output '/?example=RainbowSpiral'",
    "serve:bench": "node examples/serve.mjs . /bench/index.html",
    "bench:measure": "npm run bench && node bench/measure.mjs",
    "test": "npm run test:core && npm run test:purs && npm run test:compile-fail",
    "test:core": "tsc && spago build && node --import tsx --expose-gc --test \"packages/screamer-reactive/test/core/**/*.test.ts\"",
    "test:purs": "tsc && spago build && node scripts/test-purs.mjs",
    "test:compile-fail": "node compile-fail/run.mjs",
    "test:smoke": "node examples/smoke.mjs"
  },
  "devDependencies": {
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@types/node": "^26.6.5",
    "codemirror": "^6.0.2",
    "esbuild": "^0.28.2",
    "handlebars": "^4.7.10",
    "jsdom": "^26.1.0",
    "playwright": "^1.56.1",
    "purescript": "^0.15.16",
    "purs-tidy": "^0.11.1",
    "spago": "^1.0.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
