{
  "private": true,
  "name": "purescript-screamer",
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "bench": "tsc && node examples/build.mjs --bench && node bench/build.mjs",
    "build": "tsc && spago build",
    "build:examples": "tsc && node examples/build.mjs",
    "codegen:dom": "tsx codegen/dom.ts",
    "format": "purs-tidy format-in-place \"packages/*/src/**/*.purs\" \"packages/*/test/**/*.purs\" \"examples/**/*.purs\"",
    "hello": "tsc && node examples/build.mjs HelloWorld",
    "rainbow": "tsc && node examples/build.mjs RainbowSpiral",
    "postinstall": "spago install",
    "release": "node scripts/release.mjs",
    "serve": "node examples/serve.mjs examples/output",
    "serve:rainbow": "node examples/serve.mjs examples/output '/?example=RainbowSpiral'",
    "serve:bench": "node examples/serve.mjs . /bench/frameworks/screamer/index.html",
    "bench:measure": "npm run bench && node bench/measure.mjs",
    "test": "npm run test:core && npm run test:purs && npm run test:compile-fail",
    "test:core": "tsc && spago build && node --import tsx --expose-gc --test \"packages/screamer-reactive/test/core/**/*.test.ts\"",
    "test:purs": "tsc && spago build && node scripts/test-purs.mjs",
    "test:compile-fail": "node compile-fail/run.mjs",
    "test:smoke": "node examples/smoke.mjs",
    "inspect": "node examples/inspect.mjs",
    "set-version": "node scripts/set-version.mjs",
    "psx": "cd psx && node scripts/psx.mjs",
    "psx:build": "tsc && cd psx && spago build",
    "psx:generate": "cd psx && node scripts/psx.mjs gen-backend && node scripts/psx.mjs build examples/src && node scripts/psx.mjs build test/suite/apps",
    "psx:examples": "npm run psx:build && cd psx && node examples/scripts/build-examples.mjs && node examples/scripts/smoke-test.mjs",
    "psx:suite": "npm run psx:build && cd psx && node scripts/psx-suite.mjs"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@types/node": "^26.6.5",
    "babel-preset-solid": "1.9.3",
    "bootstrap": "3.3.6",
    "codemirror": "^6.0.2",
    "esbuild": "^0.28.2",
    "handlebars": "^4.7.10",
    "jsdom": "^26.1.0",
    "playwright": "^1.64.1",
    "purescript": "^0.15.16",
    "purs-backend-es": "1.4.3",
    "purs-tidy": "^0.11.1",
    "solid-js": "1.9.3",
    "spago": "^1.0.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "playwright-core": "^1.64.1"
  },
  "dependencies": {
    "@playwright/test": "^1.64.1"
  }
}
